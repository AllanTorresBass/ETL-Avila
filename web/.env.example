# Neon
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Vercel Blob (prefer a private store; set BLOB_ACCESS=public only for legacy)
BLOB_READ_WRITE_TOKEN=
BLOB_STORE_ID=
BLOB_ACCESS=private

# Clerk staff auth
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
# Optional comma-separated allowlist; empty = any signed-in user
CLERK_ALLOWED_EMAILS=
